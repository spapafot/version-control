{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // the edge worker + api proxy compile against Workers runtime types via
    // their own tsconfigs (worker/tsconfig.json, workers/api/tsconfig.json);
    // worker-configuration.d.ts imports worker/index.ts, so it must stay out
    // of the app program or it drags the worker (and DOM-vs-workerd type
    // conflicts) in with it.
    "worker/**/*",
    "workers/**/*",
    "backend/**/*",
    "worker-configuration.d.ts"
  ]
}
